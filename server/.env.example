NODE_ENV=development
PORT=8000
# MongoDB Atlas o un replica set local; las transacciones lo requieren.
DATABASE_URL=mongodb://127.0.0.1:27017/uptask?replicaSet=rs0
FRONTEND_URL=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
SMTP_HOST=sandbox.smtp.example.com
SMTP_PORT=2525
SMTP_USER=replace-with-your-smtp-user
SMTP_PASS=replace-with-your-smtp-password
