# Copy to /etc/uptask/server.env on the VPS; never commit the real values.
DATABASE_URL=mongodb+srv://uptask-user:replace-me@cluster.example.mongodb.net/uptask
FRONTEND_URL=https://app.example.com
JWT_SECRET=replace-with-a-long-random-secret
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-me
SMTP_PASS=replace-me
